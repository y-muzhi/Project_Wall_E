* text=auto eol=lf
# Approved content and migration checksums are byte identities, including EOL.
backend/resources/** -text
backend/app/infrastructure/migrations/** -text
backend/app/infrastructure/schemas/** -text
docs/proposals/** -text
docs/verification/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/resource-adoption-v1.json -text
docs/manual-edit-source-adoption-v1.json -text
docs/manual-identity-adoption-v1.json -text
docs/output-evidence-adoption-v2.json -text
docs/context-counting-adoption-v1.json -text
docs/deepseek-production-adoption-v1.json -text
docs/deepseek-availability-adoption-v1.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# New fixed JSON resources preserve their Windows bytes; CR is a line ending.
backend/resources/counting/v3/*.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# User-provided design originals keep their exact source bytes in Git.
docs/design/WALL-E.V1_0.6.*.md -text

# Archived source copies retain the original SHA-256 and line-number baseline.
docs/design/originals/** -text

# Classified adoption records retain their approved bytes after relocation.
docs/decisions/adoptions/** -text

# Renamed project design documents retain their byte-preservation rule.
docs/design/WALL-E.*_V_1.0.md -text

# Version directories preserve original design and source metadata byte identities.
docs/design/** -text
docs/sources/**/*.json -text
docs/sources/v1.5/prepare-v15-evaluation-v12-frozen.py -text
docs/sources/v1.5/run-v15-evaluation-v14-frozen.py -text
